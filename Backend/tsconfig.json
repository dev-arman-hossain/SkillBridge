{
  "compilerOptions": {
    "outDir": "./dist",
    "module": "commonjs",
    "target": "es2023",
    "types": ["node"],
    "moduleResolution": "bundler",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "noImplicitAny": false,
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": [
    "src/**/*",
    "lib/**/*",
    "prisma/**/*",
    "generated/**/*",
    "./"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}